<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Host-runtime infrastructure: node graph machinery, the registry
         implementation, the built-in RenderNode.  Depends on both
         contract assemblies — graph (INode) and renderable
         (IRenderable, IRenderableFactory). -->
    <TargetFrameworks>$(MetricianLibraryFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Drawing for NodeBase.Position (PointF). Replaces what
         UseWindowsForms used to bring in; kept narrow because Core
         doesn't actually use any WinForms types. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrician.Graph.Contracts\Metrician.Graph.Contracts.csproj" />
    <ProjectReference Include="..\Metrician.Renderable.Contracts\Metrician.Renderable.Contracts.csproj" />
  </ItemGroup>

</Project>
