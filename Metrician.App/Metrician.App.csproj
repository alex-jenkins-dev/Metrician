<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MetricianHostFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The .exe's icon (taskbar, Alt-Tab thumbnail, file-explorer thumbnail,
         shortcut icon).  The same file is also embedded below so each Form
         can set its own .Icon at runtime. -->
    <ApplicationIcon>metrician.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrician.Library.Rendering\Metrician.Library.Rendering.csproj" />
    <ProjectReference Include="..\Metrician.Library.Renderables\Metrician.Library.Renderables.csproj" />
    <ProjectReference Include="..\Metrician.Library.Viewport\Metrician.Library.Viewport.csproj" />
    <ProjectReference Include="..\Metrician.Core.Graph\Metrician.Core.Graph.csproj" />
    <ProjectReference Include="..\Metrician.Core.Scripting\Metrician.Core.Scripting.csproj" />
    <ProjectReference Include="..\Metrician.Core.ScriptBinding\Metrician.Core.ScriptBinding.csproj" />
    <ProjectReference Include="..\Metrician.Core.Plugins\Metrician.Core.Plugins.csproj" />
    <ProjectReference Include="..\Metrician.Library.Bridge\Metrician.Library.Bridge.csproj" />
    <ProjectReference Include="..\Metrician.Model.Graph\Metrician.Model.Graph.csproj" />
    <ProjectReference Include="..\Metrician.Presentation.Graph\Metrician.Presentation.Graph.csproj" />
    <!-- Build-only dependency: Geometry is loaded at runtime from the Plugins
         folder, not compiled into the host. The reference exists so the
         solution build orders Geometry before App and the plugin DLL is
         present when the app runs. -->
    <ProjectReference Include="..\Metrician.Nodes.Geometry\Metrician.Nodes.Geometry.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so AppIcon.Load() can pull it from the assembly's manifest
         resources without depending on a side-by-side file at runtime.
         LogicalName flattens the resource name (no namespace prefix). -->
    <EmbeddedResource Include="metrician.ico" LogicalName="metrician.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AboutBox.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="exclusions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
