<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The .exe's icon (taskbar, Alt-Tab thumbnail, file-explorer thumbnail,
         shortcut icon).  The same file is also embedded below so each Form
         can set its own .Icon at runtime. -->
    <ApplicationIcon>metrician.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core libraries linked at compile time. -->
    <ProjectReference Include="..\Metrician.Graph.Contracts\Metrician.Graph.Contracts.csproj" />
    <ProjectReference Include="..\Metrician.Renderable.Contracts\Metrician.Renderable.Contracts.csproj" />
    <ProjectReference Include="..\Metrician.Core\Metrician.Core.csproj" />
    <ProjectReference Include="..\Metrician.Graph\Metrician.Graph.csproj" />
    <ProjectReference Include="..\Metrician.Plugins\Metrician.Plugins.csproj" />
    <ProjectReference Include="..\Metrician.Renderables\Metrician.Renderables.csproj" />
    <ProjectReference Include="..\Metrician.Script\Metrician.Script.csproj" />
    <ProjectReference Include="..\Metrician.Viewport\Metrician.Viewport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-only reference: SampleNodes is loaded at runtime from Plugins/.
         Its build target copies its DLL into our output. ReferenceOutputAssembly=false
         keeps it off our compile-time graph; otherwise it would not be a plugin. -->
    <ProjectReference Include="..\Metrician.SampleNodes\Metrician.SampleNodes.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lands at $(OutDir)Plugins/exclusions.txt where PluginInstaller looks
         for it. PreserveNewest so a hand-edited runtime copy survives a
         non-source rebuild. -->
    <None Include="exclusions.txt" Link="Plugins\exclusions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so AppIcon.Load() can pull it from the assembly's manifest
         resources without depending on a side-by-side file at runtime.
         LogicalName flattens the resource name (no namespace prefix). -->
    <EmbeddedResource Include="metrician.ico" LogicalName="metrician.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AboutBox.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
