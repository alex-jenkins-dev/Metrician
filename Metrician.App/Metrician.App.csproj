<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MetricianHostFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The .exe's icon (taskbar, Alt-Tab thumbnail, file-explorer thumbnail,
         shortcut icon).  The same file is also embedded below so each Form
         can set its own .Icon at runtime. -->
    <ApplicationIcon>metrician.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrician.Renderable.Contracts\Metrician.Renderable.Contracts.csproj" />
    <ProjectReference Include="..\Metrician.Rendering\Metrician.Rendering.csproj" />
    <ProjectReference Include="..\Metrician.Renderables\Metrician.Renderables.csproj" />
    <ProjectReference Include="..\Metrician.Viewport\Metrician.Viewport.csproj" />
    <ProjectReference Include="..\Metrician.Core.Graph\Metrician.Core.Graph.csproj" />
    <ProjectReference Include="..\Metrician.Core.Scripting\Metrician.Core.Scripting.csproj" />
    <ProjectReference Include="..\Metrician.Core.ScriptBinding\Metrician.Core.ScriptBinding.csproj" />
    <ProjectReference Include="..\Metrician.Bridge\Metrician.Bridge.csproj" />
    <ProjectReference Include="..\Metrician.Model.Graph\Metrician.Model.Graph.csproj" />
    <ProjectReference Include="..\Metrician.Presentation.Graph\Metrician.Presentation.Graph.csproj" />
    <ProjectReference Include="..\Metrician.SampleNodes\Metrician.SampleNodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so AppIcon.Load() can pull it from the assembly's manifest
         resources without depending on a side-by-side file at runtime.
         LogicalName flattens the resource name (no namespace prefix). -->
    <EmbeddedResource Include="metrician.ico" LogicalName="metrician.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AboutBox.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
