<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MetricianLibraryFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Metrician script reader / writer / applier. Round-trips a NodeGraph through the line-based .metrician text format. Useful for tools that emit, validate, or consume Metrician scripts; not required for plugin authoring.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in System.Drawing (Color, PointF) without dragging in
         WinForms. Net8+ ships System.Drawing as a separate package
         outside the runtime; pinned to the lower TFM's matching version.
         The Using item replaces the global 'using System.Drawing' that
         UseWindowsForms used to inject so source can stay unqualified. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrician.Graph.Contracts\Metrician.Graph.Contracts.csproj" />
  </ItemGroup>

</Project>
