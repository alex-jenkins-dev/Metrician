<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Concrete rendering-subsystem types: geometry primitives
         (BoundingBox3D, Ray3D), camera + viewport state (Camera3D,
         StandardView), the per-frame render context, and drawing
         styles (StrokeStyle).  Sits under Metrician.Contracts.Renderables
         so that contract assembly stays purely interfaces, while the
         types it transitively needs in its public API live here.
         Uses System.Drawing types (Pen, Color) so needs the windows
         TFM + UseWindowsForms. -->
    <TargetFrameworks>$(MetricianLibraryFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Drawing in lieu of UseWindowsForms; this project does not
         use any WinForms types. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <Using Include="System.Drawing" />
  </ItemGroup>

</Project>
