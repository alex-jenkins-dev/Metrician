<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Self-contained leaf project: data-flow graph contracts (INode,
         INodePin, IDynamicNode, IDynamicPins, IVariadicInputs). No
         project references; plugin-author projects pull this in on
         its own. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
