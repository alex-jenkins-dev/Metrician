<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pure-interface contract project: IRenderable, IRenderableFactory,
         IRenderableRegistry.  Concrete types those interfaces reference
         in their signatures (BoundingBox3D, RenderContext, Camera3D,
         …) live in Metrician.Rendering and come along transitively for
         consumers.  Plugin authors writing renderers reference this
         and pick up Rendering automatically. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrician.Rendering\Metrician.Rendering.csproj" />
  </ItemGroup>

</Project>
