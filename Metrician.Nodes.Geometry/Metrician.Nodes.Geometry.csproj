<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(MetricianHostFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <Description>Built-in geometry nodes — cylinder, plane, circle, plane/cylinder intersection — plus the renderable factories that turn their outputs into the corresponding wireframe primitives.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrician.Renderable.Contracts\Metrician.Renderable.Contracts.csproj" />
    <ProjectReference Include="..\Metrician.Core.Graph\Metrician.Core.Graph.csproj" />
    <ProjectReference Include="..\Metrician.Rendering\Metrician.Rendering.csproj" />
    <ProjectReference Include="..\Metrician.Renderables\Metrician.Renderables.csproj" />
  </ItemGroup>

</Project>
